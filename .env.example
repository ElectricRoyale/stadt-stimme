# Kopieren nach .env, um Standardwerte zu überschreiben. Ohne .env läuft die Demo trotzdem.
DJANGO_SECRET_KEY=bitte-einen-langen-zufaelligen-wert-setzen
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Demo-Modus: Django Admin mit Demo-Zugang, nur lokal. Nie öffentlich betreiben.
STADTSTIMME_DEMO_MODE=true
DEMO_ADMIN_USERNAME=demo
DEMO_ADMIN_PASSWORD=demo

# Name der Stadt auf den Seiten
STADTSTIMME_CITY_NAME=Musterstadt
# Kartenkacheln ohne API-Schlüssel (Standard: OpenStreetMap Deutschland, sonst CARTO).
# Der Browser lädt sie direkt von diesen Servern.
# STADTSTIMME_MAP_TILE_URL=https://tile.openstreetmap.de/{z}/{x}/{y}.png
# STADTSTIMME_MAP_ATTRIBUTION=© OpenStreetMap-Mitwirkende
# STADTSTIMME_MAP_TILE_FALLBACK_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
# STADTSTIMME_MAP_FALLBACK_ATTRIBUTION=© OpenStreetMap-Mitwirkende © CARTO

# Schlüssel für die Code-Hashes. Einmal festlegen und nie ändern (sonst werden alle Codes ungültig).
STADTSTIMME_CODE_PEPPER=bitte-einen-langen-zufaelligen-wert-setzen
# Sperre nach Fehlversuchen beim Einlösen pro IP-Adresse
STADTSTIMME_MAX_FAILED_ATTEMPTS=10
STADTSTIMME_LOCKOUT_MINUTES=60
# Punkte verfallen nach so vielen Tagen ohne Aktivität
STADTSTIMME_POINTS_EXPIRY_DAYS=183

POSTGRES_DB=stadtstimme
POSTGRES_USER=stadtstimme
POSTGRES_PASSWORD=stadtstimme

# Ports auf dem eigenen Rechner (falls belegt, hier ändern)
APP_PORT=8000
DB_PORT=5432
MAILPIT_PORT=8025

# Vorschläge (ADR-014): Prüffrist und Schwelle werden angezeigt, Limit je Zugang und Tag.
# STADTSTIMME_PROPOSAL_REVIEW_DAYS=14
# STADTSTIMME_PROPOSAL_SUPPORT_THRESHOLD=50
# STADTSTIMME_PROPOSALS_PER_DAY=5
